<Window x:Class="SysGlance.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysGlance app settings"
        Width="420" Height="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#202020"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="White">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,6" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/SysGlance;component/logo.png" Height="18" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="App settings" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="44"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,4,16,16">

                <!-- General -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Xeneon Edge widget port" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Only change this if another app uses 5123. It must match SysGlance Port in the widget's iCUE settings."
                                           Style="{StaticResource SettingHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox x:Name="PortTextBox" Grid.Column="1" Width="80" MaxLength="5"
                                     VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Automatically check for updates" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="AutoUpdateCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingLabel}" Foreground="#C8C8C8"
                                       TextWrapping="Wrap" Margin="0,0,12,0" />
                            <Button x:Name="UpdateActionButton" Grid.Column="1" Content="Check for updates" Padding="12,5" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Settings backup" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,8"
                                   Text="SysGlance keeps a copy of your settings from each of the last 10 starts. Back up to move your setup to another PC; restoring restarts SysGlance." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BackupButton" Content="Back up settings…" />
                            <Button x:Name="RestoreButton" Grid.Column="2" Content="Restore settings…" />
                        </Grid>
                        <Button x:Name="OpenBackupsButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"
                                Margin="0,6,0,0" Padding="0,4" FontSize="12" Foreground="#9CC8F0"
                                Content="Open automatic backups folder" />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <TextBlock x:Name="AboutText" Style="{StaticResource SettingHint}" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="TourButton" Style="{StaticResource SubtleButton}" Padding="0,4" Margin="0,0,16,0"
                                    FontSize="12" Foreground="#9CC8F0" Content="Take the tour" />
                            <Button x:Name="GitHubButton" Style="{StaticResource SubtleButton}" Padding="0,4" Margin="0,0,16,0"
                                    FontSize="12" Foreground="#9CC8F0" Content="GitHub page &#x2197;" />
                            <Button x:Name="KofiButton" Style="{StaticResource SubtleButton}" Padding="0,4" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FF5E5B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Buy me a coffee" Foreground="#C8C8C8" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Uninstall -->
                <Border Style="{StaticResource Card}" BorderBrush="#40D13438">
                    <StackPanel>
                        <TextBlock Text="Uninstall" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,8"
                                   Text="Removes SysGlance from this PC: the app, its Start with Windows entry and, if ticked, your settings and backups. Remove the SysGlance widget from iCUE yourself." />
                        <CheckBox x:Name="DeleteSettingsCheckBox" Content="Also delete my settings and backups"
                                  IsChecked="True" Margin="0,0,0,10" />
                        <Button x:Name="UninstallButton" Content="Uninstall SysGlance" HorizontalAlignment="Left"
                                Padding="14,6" Foreground="#FF9A9A" BorderBrush="#66D13438" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
