<Window x:Class="SysGlance.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
        xmlns:controls="clr-namespace:SysGlance.Controls"
        Title="SysGlance Settings"
        Width="400" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#202020"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="White">

    <!-- Custom title bar over the native frame, so Windows 11 can draw Mica, rounded corners and the shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One setting: label (+ optional hint) on the left, control on the right. -->
            <Style x:Key="SettingRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,6" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="StepValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="Width" Value="46" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (draggable through WindowChrome) -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/SysGlance;component/logo.png" Height="18" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="SysGlance" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#8E8E8E"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <!-- Support link, always visible in the title bar (clickable inside the WindowChrome caption) -->
            <Button x:Name="AppSettingsButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,46,0" Height="44"
                    Style="{StaticResource TitleBarIconButton}" Content="&#xE713;"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="App settings: startup, updates, backup, uninstall" />
            <Button x:Name="KofiButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,100,0" Padding="10,4" FontSize="12"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="KofiButton_Click" ToolTip="Support SysGlance on Ko-fi">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FF5E5B" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Buy me a coffee" />
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Height="44"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click" ToolTip="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,4,16,16">

                <!-- ===== Sensors ===== -->
                <Border x:Name="SensorsCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sensors" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,8"
                                   Text="Tick what to show and use the arrows to set the order. The chart icon turns a card's mini graph on or off on the Xeneon Edge. Used by the taskbar overlay, and by the Xeneon Edge widget if you use one." />
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <controls:MetricListEditor x:Name="MetricList" Margin="0,0,8,0" />
                        </ScrollViewer>

                        <!-- Benchmark-only FPS stats warning -->
                        <Border x:Name="BenchmarkNoticeBox" Background="#33D13438" BorderBrush="#66D13438"
                                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <TextBlock Foreground="#FFB3B3" FontSize="12" TextWrapping="Wrap"
                                       Text="FPS Min/Avg/Max and 1%/0.1% Low only fill in while MSI Afterburner benchmark recording is active." />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Xeneon Edge ===== -->
                <Border x:Name="EdgeCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Xeneon Edge" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,6"
                                   Text="Optional, for owners of a Corsair Xeneon Edge. Show these sensors on it with the SysGlance iCUE widget: press Connect on the Edge, then check the code and press Trust here." />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Allow widget connection" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="WebServerCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                        </Grid>

                        <!-- Connection status -->
                        <Border Background="#08FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,4,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#8E8E8E"
                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="ConnectionStatusText" Grid.Column="1" FontSize="13"
                                           Foreground="#C8C8C8" VerticalAlignment="Center" Text="No widget connected" />
                                <Button x:Name="DisconnectButton" Grid.Column="2" Content="Disconnect"
                                        Padding="10,4" FontSize="12" ToolTip="Forget all paired widgets. They will need to connect again." />
                            </Grid>
                        </Border>

                        <Button x:Name="GetWidgetButton" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Stretch" Padding="12,8" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Get the iCUE widget" />
                                <TextBlock Text="&#x2197;" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Widget appearance (shown while a widget is connected) -->
                        <StackPanel x:Name="WebServerDetailsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4,0,8" />
                            <TextBlock Text="Widget appearance" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#C8C8C8" Margin="0,0,0,2" />

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Background" Style="{StaticResource SettingLabel}" />
                                <cp:PortableColorPicker x:Name="DashBgPicker" Grid.Column="1" Width="24" Height="24"
                                                        ShowAlpha="False" Margin="0,0,12,0" ToolTip="Widget background color" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" ToolTip="Background opacity">
                                    <Button x:Name="DashBgOpacityDecButton" Content="&#x2212;" Style="{StaticResource StepButton}" />
                                    <TextBlock x:Name="DashBgOpacityValueText" Style="{StaticResource StepValue}" />
                                    <Button x:Name="DashBgOpacityIncButton" Content="+" Style="{StaticResource StepButton}" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cards" Style="{StaticResource SettingLabel}" />
                                <cp:PortableColorPicker x:Name="DashCardPicker" Grid.Column="1" Width="24" Height="24"
                                                        ShowAlpha="False" Margin="0,0,12,0" ToolTip="Card color" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" ToolTip="Card opacity">
                                    <Button x:Name="DashCardOpacityDecButton" Content="&#x2212;" Style="{StaticResource StepButton}" />
                                    <TextBlock x:Name="DashCardOpacityValueText" Style="{StaticResource StepValue}" />
                                    <Button x:Name="DashCardOpacityIncButton" Content="+" Style="{StaticResource StepButton}" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Text size" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="WidgetTextScaleDecButton" Content="&#x2212;" Style="{StaticResource StepButton}" />
                                    <TextBlock x:Name="WidgetTextScaleValueText" Style="{StaticResource StepValue}" />
                                    <Button x:Name="WidgetTextScaleIncButton" Content="+" Style="{StaticResource StepButton}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Graphs" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="History along the bottom of each card" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="EdgeGraphOff" Content="Off" GroupName="EdgeGraphMinutes" Style="{StaticResource Segment}" />
                                        <RadioButton x:Name="EdgeGraph1" Content="1m" GroupName="EdgeGraphMinutes" Style="{StaticResource Segment}" />
                                        <RadioButton x:Name="EdgeGraph5" Content="5m" GroupName="EdgeGraphMinutes" Style="{StaticResource Segment}" />
                                        <RadioButton x:Name="EdgeGraph15" Content="15m" GroupName="EdgeGraphMinutes" Style="{StaticResource Segment}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Desktop widgets ===== -->
                <Border x:Name="DesktopWidgetsCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Desktop widgets" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,6"
                                   Text="Floating sensor widgets on your desktop. Clicks pass through them; use Edit layout to move and resize." />

                        <StackPanel x:Name="DesktopWidgetList" Margin="0,2,0,6" />

                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddDesktopWidgetButton" Content="+ Add widget" />
                            <Button x:Name="EditLayoutButton" Grid.Column="2" Content="Edit layout" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Snap to edges and other widgets" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="While moving or resizing in Edit layout. Hold Ctrl to place freely." Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <CheckBox x:Name="SnapToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="12,0,0,0" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Hide in full-screen apps" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Widgets on the same monitor as a full-screen game or video hide until you leave it. Widgets on other monitors stay." Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <CheckBox x:Name="FullscreenHideToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Taskbar overlay ===== -->
                <Border x:Name="OverlayCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Taskbar overlay" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hide taskbar overlay" Style="{StaticResource SettingLabel}" />
                            <CheckBox x:Name="HideOverlayCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font size" Style="{StaticResource SettingLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="FontSizeDecButton" Content="&#x2212;" Style="{StaticResource StepButton}" />
                                <TextBlock x:Name="FontSizeValueText" Style="{StaticResource StepValue}" />
                                <Button x:Name="FontSizeIncButton" Content="+" Style="{StaticResource StepButton}" />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Label color" Style="{StaticResource SettingLabel}" />
                            <cp:PortableColorPicker x:Name="LabelColorPicker" Grid.Column="1" Width="24" Height="24"
                                                    ShowAlpha="False" ToolTip="Click to change label color" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Position" Style="{StaticResource SettingLabel}" />
                            <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PositionLeftRadio" Content="Left" GroupName="Position" Style="{StaticResource Segment}" />
                                    <RadioButton x:Name="PositionCenterRadio" Content="Center" GroupName="Position" Style="{StaticResource Segment}" />
                                    <RadioButton x:Name="PositionRightRadio" Content="Right" GroupName="Position" Style="{StaticResource Segment}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor" Style="{StaticResource SettingLabel}" />
                            <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MonitorPrimaryRadio" Content="Primary" GroupName="Monitor" Style="{StaticResource Segment}" />
                                    <RadioButton x:Name="MonitorSecondaryRadio" Content="Secondary" GroupName="Monitor" Style="{StaticResource Segment}" />
                                    <RadioButton x:Name="MonitorTertiaryRadio" Content="Tertiary" GroupName="Monitor" Style="{StaticResource Segment}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
