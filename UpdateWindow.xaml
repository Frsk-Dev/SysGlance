<Window x:Class="SysGlance.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysGlance update"
        Width="440" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#202020"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="White">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/SysGlance;component/logo.png" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="SysGlance update" FontSize="12" Foreground="#C8C8C8" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Later_Click" ToolTip="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
            </Button>
        </Grid>

        <!-- Heading -->
        <StackPanel Grid.Row="1" Margin="20,6,20,12">
            <TextBlock x:Name="HeadingText" Text="A new version of SysGlance is available" FontSize="17" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="CurrentVersionText" FontSize="12" Foreground="#C8C8C8" />
                </Border>
                <TextBlock Text="&#x2192;" Foreground="#8E8E8E" Margin="8,0" VerticalAlignment="Center" />
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="NewVersionText" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Release notes -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="20,0,20,12" Padding="14,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="ReleasePageButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}"
                            Padding="4,0" FontSize="12" Foreground="#9CC8F0" Content="View on GitHub &#x2197;" />
                    <TextBlock Text="What's new" Style="{StaticResource SectionTitle}" FontSize="13" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="13" Foreground="#C8C8C8"
                               LineHeight="20" Margin="0,0,6,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="20,0,20,12" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#C8C8C8" Margin="0,0,0,6" TextWrapping="Wrap" />
            <Grid x:Name="ProgressTrack" Height="4">
                <Border Background="#20FFFFFF" CornerRadius="2" />
                <Border x:Name="ProgressFill" Background="{StaticResource AccentBrush}" CornerRadius="2"
                        HorizontalAlignment="Left" Width="0" />
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="4" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Style="{StaticResource SubtleButton}" Content="Skip this version"
                    Foreground="#C8C8C8" Padding="6,7" Click="Skip_Click" />
            <Button x:Name="LaterButton" Grid.Column="2" Content="Later" Padding="16,7" Click="Later_Click" />
            <Button x:Name="UpdateButton" Grid.Column="4" Style="{StaticResource AccentButton}" Content="Update now"
                    Padding="16,7" IsDefault="True" Click="Update_Click" />
        </Grid>
    </Grid>
</Window>
